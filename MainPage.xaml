<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GestorTareas.ViewModels"
             x:Class="GestorTareas.MainPage"
             Title="Gestor de Tareas"
             BackgroundColor="#F3F4F6">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">
            
            <Label Text="📝 Crear Nueva Tarea" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   TextColor="#1F2937" />

            <!-- FORMULARIO DE INGRESO -->
            <Frame BackgroundColor="White" 
                   CornerRadius="14" 
                   Padding="20" 
                   HasShadow="True"
                   BorderColor="#E5E7EB">
                <VerticalStackLayout Spacing="12">
                    
                    <Label Text="Nombre de la tarea" FontSize="14" FontAttributes="Bold" TextColor="#4B5563"/>
                    <Entry Placeholder="Ej. Presentar Proyecto 3" 
                           Text="{Binding Nombre}" 
                           TextColor="#1F2937" 
                           BackgroundColor="#F9FAFB" />
                    
                    <Label Text="Descripción" FontSize="14" FontAttributes="Bold" TextColor="#4B5563"/>
                    <Entry Placeholder="Ej. Subir código a GitHub" 
                           Text="{Binding Descripcion}" 
                           TextColor="#1F2937" 
                           BackgroundColor="#F9FAFB" />
                    
                    <Label Text="Fecha Límite" FontSize="14" FontAttributes="Bold" TextColor="#4B5563"/>
                    <DatePicker Date="{Binding FechaLimite}" TextColor="#1F2937" />

                    <!-- Selector de Hora Límite -->
                    <Label Text="Hora Límite" FontSize="14" FontAttributes="Bold" TextColor="#4B5563"/>
                    <TimePicker Time="{Binding HoraLimite}" TextColor="#1F2937" />
                    
                    <Label Text="Nivel de Prioridad" FontSize="14" FontAttributes="Bold" TextColor="#4B5563"/>
                    <Picker SelectedItem="{Binding Prioridad}" 
                            Title="Seleccione una prioridad"
                            TextColor="#1F2937"
                            BackgroundColor="#F9FAFB">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:Int32}">
                                <x:Int32>1</x:Int32>
                                <x:Int32>2</x:Int32>
                                <x:Int32>3</x:Int32>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <Button Text="💾 Guardar Tarea" 
                            Command="{Binding GuardarTareaCommand}" 
                            BackgroundColor="#4F46E5" 
                            TextColor="White" 
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="45"
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <BoxView HeightRequest="1" Color="#E5E7EB" Margin="0,5" />
            
            <Label Text="📋 Mis Tareas Registradas" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   TextColor="#1F2937" />

            <!-- LISTA DE TAREAS -->
            <CollectionView ItemsSource="{Binding ListaTareas}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,6" 
                               Padding="16" 
                               CornerRadius="12" 
                               HasShadow="True"
                               BorderColor="#E5E7EB"
                               BackgroundColor="White">
                            
                            <!-- SI ESTÁ VENCIDA, LA TARJETA SE PONE ROJA CLARO -->
                            <Frame.Triggers>
                                <DataTrigger TargetType="Frame" Binding="{Binding EsVencida}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#FEE2E2" />
                                    <Setter Property="BorderColor" Value="#F87171" />
                                </DataTrigger>
                            </Frame.Triggers>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Nombre}" 
                                       FontAttributes="Bold" 
                                       FontSize="18" 
                                       TextColor="#111827" />
                                       
                                <Label Text="{Binding Descripcion}" 
                                       FontSize="14" 
                                       TextColor="#6B7280" />
                                       
                                <HorizontalStackLayout Spacing="15" Margin="0,4,0,0">
                                    <!-- Muestra Fecha y Hora Exacta -->
                                    <Label Text="{Binding FechaLimite, StringFormat='📅 Vence: {0:dd/MM/yyyy} a las {0:HH:mm}'}" 
                                           FontSize="13" 
                                           TextColor="#374151"
                                           FontAttributes="Bold"/>
                                           
                                    <Label Text="{Binding Estado}" 
                                           FontSize="13" 
                                           FontAttributes="Bold" 
                                           TextColor="#059669"/>
                                </HorizontalStackLayout>

                                <!-- MENSAJE DE ALERTA DE TIEMPO (LANZA EL AVISO SI NO SE CUMPLIÓ A TIEMPO) -->
                                <Label Text="{Binding MensajeEstadoTiempo}" 
                                       FontSize="13" 
                                       FontAttributes="Bold" 
                                       TextColor="#B91C1C"/>

                                <!-- ETIQUETA DE PRIORIDAD -->
                                <Label FontSize="13" FontAttributes="Bold" Margin="0,2,0,4">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Prioridad}" Value="1">
                                            <Setter Property="Text" Value="🔥 Prioridad: ALTA (Urgente)" />
                                            <Setter Property="TextColor" Value="#DC2626" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Prioridad}" Value="2">
                                            <Setter Property="Text" Value="⚡ Prioridad: MEDIA (Normal)" />
                                            <Setter Property="TextColor" Value="#D97706" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Prioridad}" Value="3">
                                            <Setter Property="Text" Value="🟢 Prioridad: BAJA (Flexible)" />
                                            <Setter Property="TextColor" Value="#10B981" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                
                                <!-- BOTONES DE ACCIÓN -->
                                <HorizontalStackLayout Spacing="10" Margin="0,8,0,0">
                                    <Button Text="✅ Marcar Completada" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TareaViewModel}}, Path=CompletarTareaCommand}" 
                                            CommandParameter="{Binding .}" 
                                            BackgroundColor="#10B981" 
                                            TextColor="White"
                                            FontSize="12"
                                            CornerRadius="6"
                                            HeightRequest="36"
                                            Padding="12,0"/>
                                            
                                    <Button Text="🗑️ Eliminar" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TareaViewModel}}, Path=EliminarTareaCommand}" 
                                            CommandParameter="{Binding .}" 
                                            BackgroundColor="#EF4444" 
                                            TextColor="White"
                                            FontSize="12"
                                            CornerRadius="6"
                                            HeightRequest="36"
                                            Padding="12,0"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>